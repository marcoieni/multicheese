{
  "name": "multicheese",
  "version": "0.1.0",
  "description": "Take authenticated full-page screenshots for many URLs with Playwright and managed Chrome profiles.",
  "type": "module",
  "bin": {
    "multicheese": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "install:local": "pnpm build && node scripts/install-local.mjs"
  },
  "keywords": [
    "playwright",
    "screenshots",
    "chrome",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "commander": "^14.0.1",
    "csv-parse": "^6.1.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1"
}
